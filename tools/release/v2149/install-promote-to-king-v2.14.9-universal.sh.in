  server/release-control/src/ReleaseVersionManager.php
  server/release-control/src/ReleasePackageUploadInstaller.php
  server/release-control/src/FilesystemCleanupManager.php
  server/release-control/src/FilesystemAuditManager.php
  server/release-control/src/ReleaseSlotPolicy.php
  server/release-control/src/ReleaseSlotFilesystemProbe.php
  server/release-control/src/ReleaseSlotStore.php
  server/release-control/src/ReleaseSlotMaterializer.php
  server/release-control/src/ReleaseCandidatePackage.php
  server/release-control/src/ReleaseStateStore.php
  server/release-control/src/ReleaseRuntimeTree.php
  server/release-control/src/ReleaseDeploymentManager.php
  server/release-control/src/ReleaseCandidateInstaller.php
  server/release-control/src/ReleasePreviewTree.php
  server/release-control/src/ReleasePreviewSession.php
  server/release-control/tools/materialize-current-slot.php
  server/release-control/tools/install-candidate.php
  server/release-control/tools/prepare-preview.php
  server/release-control/tools/verify-slot.php
  server/release-control/tools/release-slot-paths.py
  server/release-control/README.md
)

PHP_FILES=(
  ReleaseControl.php
  PreviewRouter.php
  MaxRatingBackfill.php
  api/_common.php
  api/router.php
  server/shared/TaskRegistry.php
  server/team-points/public/session.php
  server/team-points/src/Auth.php
  server/team-points/src/Database.php
  server/team-points/src/PreviewIsolation.php
  server/team-points/src/bootstrap.php
  server/team-points-green/src/GreenConfig.php
  server/team-points/public/arenas-insights-export.php
  server/team-points/public/arenas-insights.php
  server/team-points/src/LiveRanksService.php
  server/team-points/src/McaResultsCronService.php
  server/team-points/src/OAuthSession.php
  server/team-points/src/Repository.php
  server/team-points-green/src/GreenCompatibility.php
  server/team-points-green/src/GreenRepository.php
  server/team-points-green/public/max-rating-backfill.php
  server/team-points-green/tools/converge-v2.13.1.php
  server/team-points-green/tools/converge-v2.13.2.php
  server/trophy-gallery/src/TrophyGalleryStore.php
  server/events-showcase/public/embed.php
  server/events-showcase/public/embed-card.php
  server/release-control/config/config.example.php
  server/release-control/public/preview-oauth-session.php
  server/release-control/src/bootstrap.php
  server/release-control/src/ReleaseControlAuth.php
  server/release-control/src/ReleaseControlState.php
  server/release-control/src/ReleaseVersionManager.php
  server/release-control/src/ReleasePackageUploadInstaller.php
  server/release-control/src/FilesystemCleanupManager.php
  server/release-control/src/ReleaseSlotPolicy.php
  server/release-control/src/ReleaseSlotFilesystemProbe.php
  server/release-control/src/ReleaseSlotStore.php
  server/release-control/src/ReleaseSlotMaterializer.php
  server/release-control/src/ReleaseCandidatePackage.php
  server/release-control/src/ReleaseStateStore.php
  server/release-control/src/ReleaseCandidateInstaller.php
  server/release-control/src/ReleasePreviewTree.php
  server/release-control/src/ReleasePreviewSession.php
  server/release-control/tools/materialize-current-slot.php
  server/release-control/tools/install-candidate.php
  server/release-control/tools/prepare-preview.php
  server/release-control/tools/verify-slot.php
)

sha256_file(){ sha256sum "$1" | awk '{print $1}'; }
fail(){ printf 'ERROR: %s\n' "$*" >&2; exit 1; }

find_php(){
  local c v
  if [[ -n "${P2K_PHP_CLI:-}" ]]; then
    [[ -x "$P2K_PHP_CLI" ]] || fail "P2K_PHP_CLI is not executable: $P2K_PHP_CLI"
    v="$("$P2K_PHP_CLI" -r 'echo PHP_VERSION_ID;' 2>/dev/null || true)"
    [[ "$v" =~ ^[0-9]+$ ]] && (( v >= 80000 )) || fail "P2K_PHP_CLI must be PHP >= 8.0"
    printf '%s\n' "$P2K_PHP_CLI"; return
  fi
  for c in /usr/bin/php8.5-cli /usr/bin/php8.5 /usr/bin/php8.4-cli /usr/bin/php8.4 /usr/bin/php8.3-cli /usr/bin/php8.3 /usr/bin/php8.2-cli /usr/bin/php8.2 /usr/bin/php8.1-cli /usr/bin/php8.1 /usr/bin/php8.0-cli /usr/bin/php8.0; do
    [[ -x "$c" ]] || continue
    v="$("$c" -r 'echo PHP_VERSION_ID;' 2>/dev/null || true)"
    if [[ "$v" =~ ^[0-9]+$ ]] && (( v >= 80000 )); then printf '%s\n' "$c"; return; fi
  done
  if command -v php >/dev/null 2>&1; then
    c="$(command -v php)"; v="$("$c" -r 'echo PHP_VERSION_ID;' 2>/dev/null || true)"
    if [[ "$v" =~ ^[0-9]+$ ]] && (( v >= 80000 )); then printf '%s\n' "$c"; return; fi
  fi
  fail "No PHP >= 8.0 CLI found. Do not use legacy /usr/bin/php."
}

find_python(){
  local c major
  for c in python3 python; do
    command -v "$c" >/dev/null 2>&1 || continue
    c="$(command -v "$c")"
    major="$("$c" -c 'import sys; print(sys.version_info[0])' 2>/dev/null || true)"
    [[ "$major" == "3" ]] && { printf '%s\n' "$c"; return; }
  done
  fail "Python 3 is required for canonical 2.13.x baseline verification."
}

baseline_row(){
  local version="$1" path="$2"
  awk -F '\t' -v version="$version" -v path="$path" '$1==version && $2==path {print $3 "\t" $4; exit}' "$BASELINES"
}

hash_allowed(){
  local got="$1" hashes="$2"
  case ",$hashes," in *",$got,"*) return 0 ;; *) return 1 ;; esac
}

canonical_hash(){
  "$PYTHON_BIN" "$CANON" --logical-path "$1" "$2"
}

target_hash(){
  local path="$1"
  awk -v wanted="./$path" '$2==wanted {print $1; exit}' "$SELF_DIR/PAYLOAD.sha256"
}

rollback(){
  local path
  printf 'Rolling back source files from %s\n' "$BACKUP_DIR" >&2
  for path in "${FILES[@]}"; do
    if [[ -f "$BACKUP_DIR/$path" ]]; then
      mkdir -p "$(dirname "$ROOT/$path")"
      cp -p "$BACKUP_DIR/$path" "$ROOT/$path" || true
    elif [[ -f "$ABSENT_FILE" ]] && grep -Fxq "$path" "$ABSENT_FILE"; then
      rm -f "$ROOT/$path" || true
    fi
  done
  ACTIVATED=0
}

abort_after_activation(){
  printf 'ERROR: %s\n' "$*" >&2
  rollback
  printf 'Source files were rolled back. Successful additive schema changes are intentionally left in place.\n' >&2
  exit 1
}

[[ -d "$ROOT" ]] || fail "Promote to King root not found: $ROOT"
[[ -d "$PAYLOAD_DIR" ]] || fail "Installer payload directory missing: $PAYLOAD_DIR"
[[ -f "$BASELINES" ]] || fail "Installer baseline manifest missing: $BASELINES"
[[ -f "$CANON" ]] || fail "Canonical hash helper missing: $CANON"
command -v sha256sum >/dev/null 2>&1 || fail "sha256sum is required"

PHP_BIN="$(find_php)"
PYTHON_BIN="$(find_python)"
PHP_VERSION="$("$PHP_BIN" -r 'echo PHP_VERSION;')"
INSTALLED_VERSION="$(tr -d '\r\n' < "$ROOT/VERSION" 2>/dev/null || true)"
case "$INSTALLED_VERSION" in
  2.13.0|2.13.1|2.13.2|2.13.3|2.13.4|2.13.5|2.14.0|2.14.1|2.14.2|2.14.3|2.14.4|2.14.5|2.14.6|2.14.7|2.14.9) ;;
  *) fail "Unsupported installed VERSION '$INSTALLED_VERSION'. This installer supports existing 2.13.0 through 2.14.9 installations only." ;;
esac

printf 'Using PHP CLI: %s (%s)\n' "$PHP_BIN" "$PHP_VERSION"
printf 'Installed version: %s\n' "$INSTALLED_VERSION"
printf 'Target source identity: v2.14.9 %s\n' "$SOURCE_HEAD"
printf 'Static asset cache key: %s\n' "$CACHE_KEY"

printf 'Verifying package payload...\n'
( cd "$PAYLOAD_DIR" && sha256sum -c "$SELF_DIR/PAYLOAD.sha256" ) || fail "Package payload hash verification failed"

printf 'Checking approved installed baseline...\n'
for path in "${FILES[@]}"; do
  row="$(baseline_row "$INSTALLED_VERSION" "$path")"
  [[ -n "$row" ]] || fail "No approved baseline rule for $INSTALLED_VERSION: $path"
  allow_absent="${row%%$'\t'*}"
  hashes="${row#*$'\t'}"
  live="$ROOT/$path"
  if [[ ! -e "$live" ]]; then
    if [[ "$allow_absent" == "1" ]]; then
      printf '  %s: absent (approved for %s)\n' "$path" "$INSTALLED_VERSION"
      continue
    fi
    fail "Required installed file is missing for $INSTALLED_VERSION: $path"
  fi
  got="$(canonical_hash "$path" "$live")" || fail "Unable to canonicalize installed file: $path"
  hash_allowed "$got" "$hashes" || fail "Installed file is not an approved $INSTALLED_VERSION state: $path ($got canonical SHA-256)"
  printf '  %s: approved\n' "$path"
done

printf 'Linting staged PHP...\n'
for path in "${PHP_FILES[@]}"; do
  "$PHP_BIN" -l "$PAYLOAD_DIR/$path" >/dev/null || fail "PHP lint failed for staged $path"
done

if [[ "${P2K_INSTALL_PREFLIGHT_ONLY:-0}" == "1" ]]; then
  printf 'SUCCESS: v2.14.9 cumulative installer preflight passed for %s; no files were changed.\n' "$INSTALLED_VERSION"
  exit 0
fi

[[ -f "$SLOT_SELECTOR" ]] || fail "Release slot path selector is missing from payload"
[[ -f "$SLOT_MATERIALIZER_PAYLOAD" ]] || fail "Release slot materializer is missing from payload"
printf 'Materializing protected pre-upgrade release slot for %s...\n' "$INSTALLED_VERSION"
PRE_SLOT_RESULT="$("$PYTHON_BIN" "$SLOT_SELECTOR" --root "$ROOT" | "$PHP_BIN" "$SLOT_MATERIALIZER_PAYLOAD" --root="$ROOT" --version="$INSTALLED_VERSION" --paths=-)" \
  || fail "Unable to materialize the pre-upgrade release slot; production was not changed"
printf '%s\n' "$PRE_SLOT_RESULT"

mkdir -p "$BACKUP_DIR" || fail "Unable to create backup directory: $BACKUP_DIR"
: > "$ABSENT_FILE"
for path in "${FILES[@]}"; do
  if [[ -e "$ROOT/$path" ]]; then
    mkdir -p "$BACKUP_DIR/$(dirname "$path")" || fail "Unable to prepare backup path for $path"
    cp -p "$ROOT/$path" "$BACKUP_DIR/$path" || fail "Unable to back up $path"
  else
    printf '%s\n' "$path" >> "$ABSENT_FILE"
  fi
done
printf 'Backup created: %s\n' "$BACKUP_DIR"

ACTIVATED=1
trap 'if (( ACTIVATED )); then rollback; fi; exit 130' INT TERM HUP

activate_file(){
  local path="$1" src="$PAYLOAD_DIR/$1" dst="$ROOT/$1" tmp
  mkdir -p "$(dirname "$dst")" || abort_after_activation "Unable to create destination directory for $path"
  tmp="$dst.p2k-v2149-$$.tmp"
  cp -p "$src" "$tmp" || abort_after_activation "Unable to stage live $path"
  mv -f "$tmp" "$dst" || abort_after_activation "Unable to activate $path"
}

printf 'Activating cumulative v2.14.9 runtime files...\n'
for path in "${FILES[@]}"; do
  [[ "$path" == "VERSION" ]] && continue
  activate_file "$path"
done

printf 'Linting active PHP...\n'
for path in "${PHP_FILES[@]}"; do
  "$PHP_BIN" -l "$ROOT/$path" >/dev/null || abort_after_activation "PHP lint failed after activation: $path"
done

printf 'Converging and verifying inherited Green schemas...\n'
"$PHP_BIN" "$ROOT/server/team-points-green/tools/converge-v2.13.1.php" || abort_after_activation "v2.13.1 Green schema convergence/verification failed"
"$PHP_BIN" "$ROOT/server/team-points-green/tools/converge-v2.13.2.php" || abort_after_activation "v2.13.2 Green schema convergence/verification failed"

activate_file VERSION

printf 'Verifying installed target hashes...\n'
for path in "${FILES[@]}"; do
  got="$(sha256_file "$ROOT/$path")"
  expected="$(target_hash "$path")"
  [[ -n "$expected" && "$got" == "$expected" ]] || abort_after_activation "Target hash mismatch after activation: $path"
  printf '  %s: OK\n' "$path"
done
[[ "$(tr -d '\r\n' < "$ROOT/VERSION")" == "2.14.9" ]] || abort_after_activation "VERSION did not converge to 2.14.9"

grep -Fq "?v=$CACHE_KEY" "$ROOT/ui-v2.html" || abort_after_activation "ui-v2 cache key was not activated"
grep -Fq "?v=$CACHE_KEY" "$ROOT/RecruitMatch.html" || abort_after_activation "RecruitMatch cache key was not activated"
grep -Fq "?v=$CACHE_KEY" "$ROOT/ChallengeListAssistant.html" || abort_after_activation "ChallengeListAssistant cache key was not activated"
grep -Fq "?v=$CACHE_KEY" "$ROOT/InsightsHealth.html" || abort_after_activation "InsightsHealth cache key was not activated"
grep -Fq "const TROPHY_RUNTIME_KEY = \"$CACHE_KEY\";" "$ROOT/assets/js/admin/tool-registry.js" || abort_after_activation "Trophy runtime cache key was not activated"
grep -Fq "assets/js/pages/recruit-match.js?v=$CACHE_KEY" "$ROOT/assets/js/pages/recruit-match-v2121-bootstrap.js" || abort_after_activation "Recruitment controller cache key was not activated"
grep -Fq "assets/js/shared/events-showcase-core.js?v=$CACHE_KEY" "$ROOT/server/events-showcase/public/embed.php" || abort_after_activation "Events Showcase line cache key was not activated"
grep -Fq "assets/js/shared/events-showcase-core.js?v=$CACHE_KEY" "$ROOT/server/events-showcase/public/embed-card.php" || abort_after_activation "Events Showcase card cache key was not activated"
grep -Fq 'v2.14.9 · ZIP install + filesystem cleanup' "$ROOT/ReleaseControl.php" || abort_after_activation "Release Control v2.14.9 management page was not activated"
grep -Fq 'class ReleasePackageUploadInstaller' "$ROOT/server/release-control/src/ReleasePackageUploadInstaller.php" || abort_after_activation "Browser ZIP package installer was not activated"
grep -Fq 'class FilesystemCleanupManager' "$ROOT/server/release-control/src/FilesystemCleanupManager.php" || abort_after_activation "Filesystem cleanup manager was not activated"
grep -Fq 'class ReleaseVersionManager' "$ROOT/server/release-control/src/ReleaseVersionManager.php" || abort_after_activation "Release version manager was not activated"
grep -Fq "'candidate_install' => true" "$ROOT/server/release-control/src/ReleaseControlState.php" || abort_after_activation "Candidate-install capability was not activated"
grep -Fq "'personal_preview' => true" "$ROOT/server/release-control/src/ReleaseControlState.php" || abort_after_activation "Personal candidate preview was not activated"
grep -Fq "'promotion'=>\$candidateValid && \$candidatePreviewValid && \$publicValid" "$ROOT/server/release-control/src/ReleaseControlState.php" || abort_after_activation "Promotion capability was not activated"
grep -Fq "'rollback'=>\$mode === 'slots'" "$ROOT/server/release-control/src/ReleaseControlState.php" || abort_after_activation "Rollback capability was not activated"
grep -Fq "'public_slot_routing'=>true" "$ROOT/server/release-control/src/ReleaseControlState.php" || abort_after_activation "Public slot routing was not activated"
grep -Fq "'candidate_cron' => false" "$ROOT/server/release-control/src/ReleaseControlState.php" || abort_after_activation "Candidate CRON must remain disabled"
grep -Fq 'controlCsrfToken' "$ROOT/server/release-control/src/ReleaseControlAuth.php" || abort_after_activation "Recovery-plane CSRF hardening was not activated"
grep -Fq 'href="/ReleaseControl.php"' "$ROOT/assets/js/admin/admin-shell.js" || abort_after_activation "Maintenance Release Control card was not activated"
grep -Fq "'status'=>'preview_isolated'" "$ROOT/api/router.php" || abort_after_activation "Preview CRON diagnostics semantics were not activated"
grep -Fq 'P2KRC_PREVIEW' "$ROOT/.htaccess" || abort_after_activation "Preview routing hint was not activated"
grep -Fq 'CANDIDATE_PREVIEW_WRITE_BLOCKED' "$ROOT/PreviewRouter.php" || abort_after_activation "Preview write block was not activated"
grep -Fq "PHP_SAPI !== 'cli'" "$ROOT/server/release-control/tools/install-candidate.php" || abort_after_activation "Candidate installer must remain CLI-only"

printf 'Materializing verified v2.14.9 release slot...\n'
TARGET_SLOT_RESULT="$("$PYTHON_BIN" "$ROOT/server/release-control/tools/release-slot-paths.py" --root "$ROOT" | "$PHP_BIN" "$ROOT/server/release-control/tools/materialize-current-slot.php" --root="$ROOT" --version="2.14.9" --source-head="$SOURCE_HEAD" --cache-key="$CACHE_KEY" --paths=-)" \
  || abort_after_activation "Unable to materialize the verified v2.14.9 release slot"
printf '%s\n' "$TARGET_SLOT_RESULT"

ACTIVATED=0
trap - INT TERM HUP
printf 'SUCCESS: Promote to King v2.14.9 cumulative 2.13.x upgrade is active.\n'
printf 'Qualified source HEAD: %s\n' "$SOURCE_HEAD"
printf 'Static cache key: %s\n' "$CACHE_KEY"
printf 'Rollback backup retained at: %s\n' "$BACKUP_DIR"
