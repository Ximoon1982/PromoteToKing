#!/usr/bin/env bash
set -uo pipefail

ROOT="${1:-/kunden/homepages/43/d141198007/htdocs/PromoteToKing}"
SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PAYLOAD_DIR="$SELF_DIR/payload"
BASELINES="$SELF_DIR/BASELINES.tsv"
CANON="$SELF_DIR/canonical-hash.py"
BACKUP_ROOT="$ROOT/storage/release-backups"
STAMP="$(date -u +%Y%m%dT%H%M%SZ)-$$"
BACKUP_DIR="$BACKUP_ROOT/v2.14.9-$STAMP"
ABSENT_FILE="$BACKUP_DIR/.absent-before-install"
ACTIVATED=0
SOURCE_HEAD="@@SOURCE_HEAD@@"
CACHE_KEY="@@CACHE_KEY@@"
SLOT_SELECTOR="$PAYLOAD_DIR/server/release-control/tools/release-slot-paths.py"
SLOT_MATERIALIZER_PAYLOAD="$PAYLOAD_DIR/server/release-control/tools/materialize-current-slot.php"

FILES=(
  .htaccess
  VERSION
  ReleaseControl.php
  PreviewRouter.php
  PublicRouter.php
  ui-v2.html
  TeamPointsAdmin.html
  ClubIntelligence.html
  assets/js/pages/team-points-admin.js
  assets/js/pages/club-intelligence.js
