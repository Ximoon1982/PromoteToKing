#!/usr/bin/env bash
set -euo pipefail

DEFAULT_ROOT="/kunden/homepages/43/d141198007/htdocs/PromoteToKing"
ROOT="${1:-$DEFAULT_ROOT}"
ACTION="${2:-install}"

POC_SOURCE_COMMIT="aed6ad0fcebd95e0dd176f3eeb33e9d30b714505"
POC_CACHE_KEY="poc-aed6ad0fcebd-20260905"
RAW_URL="https://raw.githubusercontent.com/Ximoon1982/PromoteToKing/${POC_SOURCE_COMMIT}/assets/js/admin/trophy-gallery-poc.js"

if [[ "$ACTION" != "install" && "$ACTION" != "--remove" && "$ACTION" != "remove" ]]; then
  echo "Usage: $0 [P2K_ROOT] [install|--remove]" >&2
  exit 2
fi

if ! command -v python3 >/dev/null 2>&1; then
  echo "ERROR: python3 is required for this test overlay installer." >&2
  exit 3
fi

export P2K_TROPHY_ROOT="$ROOT"
export P2K_TROPHY_ACTION="$ACTION"
export P2K_TROPHY_SOURCE_COMMIT="$POC_SOURCE_COMMIT"
export P2K_TROPHY_CACHE_KEY="$POC_CACHE_KEY"
export P2K_TROPHY_RAW_URL="$RAW_URL"

python3 - <<'PY'
from __future__ import annotations
import datetime as dt
import hashlib
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import urllib.request

root = Path(os.environ["P2K_TROPHY_ROOT"]).resolve()
action = os.environ["P2K_TROPHY_ACTION"]
source_commit = os.environ["P2K_TROPHY_SOURCE_COMMIT"]
cache_key = os.environ["P2K_TROPHY_CACHE_KEY"]
raw_url = os.environ["P2K_TROPHY_RAW_URL"]

registry = root / "assets/js/admin/tool-registry.js"
poc_target = root / "assets/js/admin/trophy-gallery-poc.js"
ui = root / "ui-v2.html"

begin = "/* P2K_TROPHY_GALLERY_POC_OVERLAY_BEGIN */"
end = "/* P2K_TROPHY_GALLERY_POC_OVERLAY_END */"
sentinel = "return Object.freeze({ tools, renderTools, routeFallback });"

def die(msg: str, code: int = 10) -> None:
    print(f"ERROR: {msg}", file=sys.stderr)
    raise SystemExit(code)

if not root.is_dir():
    die(f"P2K root does not exist: {root}")
if not registry.is_file() or not ui.is_file():
    die("Target does not look like a Promote to King 2.11.x tree (ui-v2.html/tool-registry.js missing).")

ui_text = ui.read_text(encoding="utf-8", errors="replace")
registry_text = registry.read_text(encoding="utf-8")
if not re.search(r"\b2\.11\.\d+", ui_text):
    die("No 2.11.x version evidence found in ui-v2.html; refusing to patch an unknown tree.")
if sentinel not in registry_text:
    die("Current tool-registry.js does not contain the expected v2.11.x registry sentinel; no changes made.")

stamp = dt.datetime.now(dt.timezone.utc).strftime("%Y%m%dT%H%M%S%fZ")
backup = root / ".p2k-poc-backups" / f"trophy-gallery-{stamp}"
backup.mkdir(parents=True, exist_ok=False)
shutil.copy2(registry, backup / "tool-registry.js")
had_poc = poc_target.exists()
if had_poc:
    shutil.copy2(poc_target, backup / "trophy-gallery-poc.js")

manifest = {
    "created_utc": stamp,
    "action": action,
    "root": str(root),
    "source_commit": source_commit,
    "registry_sha256_before": hashlib.sha256(registry.read_bytes()).hexdigest(),
    "poc_existed_before": had_poc,
}
(backup / "manifest.json").write_text(json.dumps(manifest, indent=2) + "\n", encoding="utf-8")

def restore() -> None:
    shutil.copy2(backup / "tool-registry.js", registry)
    if had_poc:
        shutil.copy2(backup / "trophy-gallery-poc.js", poc_target)
    else:
        poc_target.unlink(missing_ok=True)

def strip_overlay(text: str) -> str:
    pattern = re.compile(
        re.escape(begin) + r".*?" + re.escape(end) + r"\n?",
        re.S,
    )
    return pattern.sub("", text)

try:
    if action in ("--remove", "remove"):
        if begin not in registry_text:
            if "trophy-gallery-poc.js" in registry_text:
                die("A Trophy Gallery loader exists but is not owned by this overlay installer; refusing to remove native/branch integration.")
            print("Trophy Gallery POC overlay is not installed; nothing to remove.")
        else:
            patched = strip_overlay(registry_text)
            tmp = registry.with_suffix(".js.p2k-trophy-remove.tmp")
            tmp.write_text(patched, encoding="utf-8")
            shutil.copymode(registry, tmp)
            os.replace(tmp, registry)
            poc_target.unlink(missing_ok=True)
            print("Trophy Gallery POC overlay removed.")
        print(f"Backup retained at: {backup}")
        raise SystemExit(0)

    if "trophy-gallery-poc.js" in registry_text and begin not in registry_text:
        die("This P2K tree already references trophy-gallery-poc.js outside the overlay marker. It may already contain the feature branch; refusing to duplicate it.")

    source_override = os.environ.get("P2K_TROPHY_POC_SOURCE_FILE", "").strip()
    if source_override:
        source = Path(source_override).read_bytes()
    else:
        req = urllib.request.Request(
            raw_url,
            headers={"User-Agent": "PromoteToKing-TrophyGallery-POC-Installer/1"},
        )
        try:
            with urllib.request.urlopen(req, timeout=30) as response:
                source = response.read()
        except Exception as exc:
            die(
                "Could not fetch the immutable Trophy Gallery POC payload from GitHub. "
                f"Network error: {exc}. No production files have been changed."
            )

    try:
        source_text = source.decode("utf-8")
    except UnicodeDecodeError:
        die("Downloaded Trophy Gallery payload is not UTF-8.")
    required_markers = (
        'const STORAGE_KEY = "p2k-trophy-gallery-poc-v1"',
        "P2K_TROPHY_GALLERY_POC",
        'tab.dataset.hallSubtab="trophies"',
        "p2kTrophyAdminPanel",
    )
    missing = [m for m in required_markers if m not in source_text]
    if missing:
        die("Downloaded payload failed contract validation: " + ", ".join(missing))

    block = f'''{begin}
function loadTrophyGalleryPocOverlay() {{
if (window.P2K_TROPHY_GALLERY_POC) {{ window.P2K_TROPHY_GALLERY_POC.mount?.(context); return; }}
if (document.getElementById("p2kTrophyGalleryPocScript")) return;
const script = document.createElement("script");
script.id = "p2kTrophyGalleryPocScript";
script.src = "assets/js/admin/trophy-gallery-poc.js?v={cache_key}";
script.defer = true;
script.onload = () => window.P2K_TROPHY_GALLERY_POC?.mount?.(context);
document.head.appendChild(script);
}}
loadTrophyGalleryPocOverlay();
{end}
'''

    clean_registry = strip_overlay(registry_text)
    if sentinel not in clean_registry:
        die("Registry sentinel disappeared while preparing patch.")
    patched_registry = clean_registry.replace(sentinel, block + sentinel, 1)

    poc_target.parent.mkdir(parents=True, exist_ok=True)
    poc_tmp = poc_target.with_suffix(".js.p2k-trophy.tmp")
    poc_tmp.write_bytes(source)
    if poc_target.exists():
        shutil.copymode(poc_target, poc_tmp)
    os.replace(poc_tmp, poc_target)

    reg_tmp = registry.with_suffix(".js.p2k-trophy.tmp")
    reg_tmp.write_text(patched_registry, encoding="utf-8")
    shutil.copymode(registry, reg_tmp)
    os.replace(reg_tmp, registry)

    final_registry = registry.read_text(encoding="utf-8")
    final_poc = poc_target.read_text(encoding="utf-8")
    checks = {
        "overlay_begin_once": final_registry.count(begin) == 1,
        "overlay_end_once": final_registry.count(end) == 1,
        "payload_reference_once": final_registry.count("trophy-gallery-poc.js?v=" + cache_key) == 1,
        "payload_runtime_marker": "P2K_TROPHY_GALLERY_POC" in final_poc,
        "admin_gate_marker": "isAdminVisible()" in final_poc,
    }
    failed = [name for name, ok in checks.items() if not ok]
    if failed:
        die("Post-install validation failed: " + ", ".join(failed))

    node = shutil.which("node")
    if node:
        for path in (registry, poc_target):
            result = subprocess.run([node, "--check", str(path)], text=True, capture_output=True)
            if result.returncode:
                die(f"JavaScript syntax validation failed for {path}: {result.stderr.strip()}")

    manifest["registry_sha256_after"] = hashlib.sha256(registry.read_bytes()).hexdigest()
    manifest["poc_sha256"] = hashlib.sha256(poc_target.read_bytes()).hexdigest()
    manifest["cache_key"] = cache_key
    manifest["validation"] = checks
    (backup / "manifest.json").write_text(json.dumps(manifest, indent=2) + "\n", encoding="utf-8")

    print("Trophy Gallery POC overlay installed successfully.")
    print(f"Target: {root}")
    print(f"Runtime source commit: {source_commit}")
    print(f"Cache key: {cache_key}")
    print(f"Backup: {backup}")
    print("Visibility: admin-authenticated users only.")
    print("No PHP, database, configuration, storage, OAuth or CRON files were changed.")
except BaseException:
    exc = sys.exc_info()[1]
    if isinstance(exc, SystemExit) and exc.code == 0:
        raise
    try:
        restore()
        print(f"Rollback completed from: {backup}", file=sys.stderr)
    except Exception as restore_exc:
        print(f"WARNING: automatic rollback failed: {restore_exc}", file=sys.stderr)
        print(f"Manual backup is at: {backup}", file=sys.stderr)
    raise
PY
