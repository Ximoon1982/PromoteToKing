#!/usr/bin/env bash
set -euo pipefail
ROOT="${1:-/kunden/homepages/43/d141198007/htdocs/PromoteToKing}"
ACTION="${2:-install}"
SOURCE_COMMIT="a7555ea1e512e99261c4b2ae6451b9496cf89450"
CACHE_KEY="poc-a7555ea1e512-20260909-r5"
[[ "$ACTION" == install || "$ACTION" == remove || "$ACTION" == --remove ]] || { echo "Usage: $0 [P2K_ROOT] [install|remove]" >&2; exit 2; }
command -v python3 >/dev/null || { echo "ERROR: python3 is required." >&2; exit 3; }
export P2K_TROPHY_ROOT="$ROOT" P2K_TROPHY_ACTION="$ACTION" P2K_TROPHY_SOURCE_COMMIT="$SOURCE_COMMIT" P2K_TROPHY_CACHE_KEY="$CACHE_KEY"
python3 - <<'PY'
from __future__ import annotations
import datetime as dt, hashlib, io, json, os, re, shutil, sys, tarfile, urllib.request
from pathlib import Path

root=Path(os.environ['P2K_TROPHY_ROOT']).resolve(); action=os.environ['P2K_TROPHY_ACTION']; commit=os.environ['P2K_TROPHY_SOURCE_COMMIT']; key=os.environ['P2K_TROPHY_CACHE_KEY']
state_dir=root/'.p2k-poc-state'; state_path=state_dir/'trophy-gallery-overlay.json'; backups=root/'.p2k-poc-backups'
begin='/* P2K_TROPHY_GALLERY_POC_OVERLAY_BEGIN */'; end='/* P2K_TROPHY_GALLERY_POC_OVERLAY_END */'; sentinel='return Object.freeze({ tools, renderTools, routeFallback });'
payload=[
 'assets/js/admin/admin-shell.js','assets/js/admin/trophy-gallery-poc.js','assets/js/pages/dashboard-v2.js',
 'assets/trophy-gallery/engraving/P2KFullSans.ttf','assets/trophy-gallery/engraving/editor.html',
 *[f'assets/trophy-gallery/engraving/{kind}_{finish}.png' for kind in ('medal','cup','crystal') for finish in ('gold','silver','bronze')],
 'server/trophy-gallery/src/TrophyGalleryStore.php','server/trophy-gallery/public/api.php','server/trophy-gallery/public/media.php','trophies/index.html','tools/poc/engraving/README.md']
registry=root/'assets/js/admin/tool-registry.js'; ui=root/'ui-v2.html'

def die(msg,code=10): print('ERROR:',msg,file=sys.stderr); raise SystemExit(code)
def atomic(path,data):
 path.parent.mkdir(parents=True,exist_ok=True); tmp=path.with_name(path.name+'.trophy-r5.tmp'); tmp.write_bytes(data); os.replace(tmp,path)
def strip_block(text): return re.sub(re.escape(begin)+r'.*?'+re.escape(end)+r'\n?','',text,flags=re.S)
def registry_ref(text):
 m=re.search(r'assets/js/admin/tool-registry\.js(?:\?[^"\'<> ]*)?',text)
 if not m: die('ui-v2.html has no local tool-registry reference.')
 return m
def with_token(src):
 src=re.sub(r'([?&])p2k_trophy_poc=[^&#]*',lambda m:'?' if m.group(1)=='?' else '',src).replace('?&','?').replace('&&','&').rstrip('?&')
 return src+('&' if '?' in src else '?')+'p2k_trophy_poc='+key
def restore(backup,meta):
 for rel,info in meta['files'].items():
  target=root/rel; saved=backup/'files'/rel
  if info['existed']: target.parent.mkdir(parents=True,exist_ok=True); shutil.copy2(saved,target)
  elif target.exists() and target.is_file(): target.unlink()

if not root.is_dir() or not registry.is_file() or not ui.is_file(): die('Target is not a recognizable Promote to King tree.')
if not re.search(r'\b2\.11\.\d+',ui.read_text(encoding='utf-8',errors='replace')): die('Installer supports Promote to King 2.11.x only.')

if action in ('remove','--remove'):
 if not state_path.is_file(): die('Trophy Gallery r5 installation state was not found.')
 state=json.loads(state_path.read_text()); backup=Path(state['original_backup']); restore(backup,state); state_path.unlink(); print('Trophy Gallery r5 removed; persistent data/trophy-gallery was retained.'); print('Restored:',backup); raise SystemExit(0)

stamp=dt.datetime.now(dt.timezone.utc).strftime('%Y%m%dT%H%M%S%fZ'); backup=backups/f'trophy-gallery-r5-{stamp}'; (backup/'files').mkdir(parents=True)
existing=json.loads(state_path.read_text()) if state_path.is_file() else None
reinstall=isinstance(existing,dict) and existing.get('overlay_version')==5
original_backup=Path(existing['original_backup']) if reinstall else backup
managed=payload+['assets/js/admin/tool-registry.js','ui-v2.html']; current_files={}; meta={'overlay_version':5,'source_commit':commit,'cache_key':key,'installed_utc':stamp,'original_backup':str(original_backup),'files':existing['files'] if reinstall else {}}
for rel in managed:
 target=root/rel; current_files[rel]={'existed':target.is_file(),'sha256':hashlib.sha256(target.read_bytes()).hexdigest() if target.is_file() else None}
 if not reinstall: meta['files'][rel]=current_files[rel]
 if target.is_file(): saved=backup/'files'/rel; saved.parent.mkdir(parents=True,exist_ok=True); shutil.copy2(target,saved)

try:
 override=os.environ.get('P2K_TROPHY_ARCHIVE_FILE','').strip()
 if override: archive=Path(override).read_bytes()
 else:
  url=f'https://github.com/Ximoon1982/PromoteToKing/archive/{commit}.tar.gz'; req=urllib.request.Request(url,headers={'User-Agent':'P2K-Trophy-Gallery-r5-installer'})
  with urllib.request.urlopen(req,timeout=90) as response: archive=response.read()
 with tarfile.open(fileobj=io.BytesIO(archive),mode='r:gz') as tar:
  prefix=tar.getnames()[0].split('/',1)[0]
  for rel in payload:
   member=tar.getmember(prefix+'/'+rel); source=tar.extractfile(member)
   if source is None: die('Immutable payload is missing '+rel)
   atomic(root/rel,source.read())
 registry_text=strip_block(registry.read_text(encoding='utf-8'))
 if sentinel not in registry_text: die('Unsupported tool-registry layout; rollback required.')
 block=f'''{begin}\nfunction loadTrophyGalleryPocOverlay() {{\nif (window.P2K_TROPHY_GALLERY_POC) {{ window.P2K_TROPHY_GALLERY_POC.mount?.(context); return; }}\nif (document.getElementById("p2kTrophyGalleryPocScript")) return;\nconst script=document.createElement("script");script.id="p2kTrophyGalleryPocScript";script.src="assets/js/admin/trophy-gallery-poc.js?v={key}";script.defer=true;script.onload=()=>window.P2K_TROPHY_GALLERY_POC?.mount?.(context);document.head.appendChild(script);\n}}\nloadTrophyGalleryPocOverlay();\n{end}\n'''
 atomic(registry,(registry_text.replace(sentinel,block+sentinel,1)).encode())
 ui_text=ui.read_text(encoding='utf-8'); match=registry_ref(ui_text); new_ref=with_token(match.group(0)); atomic(ui,(ui_text[:match.start()]+new_ref+ui_text[match.end():]).encode())
 required=['server/trophy-gallery/public/api.php','assets/trophy-gallery/engraving/editor.html','trophies/index.html']
 if any(not (root/x).is_file() for x in required) or key not in registry.read_text() or key not in ui.read_text(): die('Installed tree failed r5 validation.')
 state_dir.mkdir(parents=True,exist_ok=True); state_path.write_text(json.dumps(meta,indent=2)+'\n')
 print('Trophy Gallery r5 installed successfully.');print('Source commit:',commit);print('Cache key:',key);print('Backup:',backup);print('Persistent catalog/media location:',root/'data/trophy-gallery');print('CRON, OAuth, databases and configuration were not modified.')
except BaseException:
 try: restore(backup,{'files':current_files}); print('Rollback completed from:',backup,file=sys.stderr)
 except Exception as exc: print('WARNING: rollback failed:',exc,'Backup:',backup,file=sys.stderr)
 raise
PY
