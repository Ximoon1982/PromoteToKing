#!/usr/bin/env bash
set -euo pipefail
ROOT="${1:-/kunden/homepages/43/d141198007/htdocs/PromoteToKing}"
ACTION="${2:-install}"
SOURCE_COMMIT="e883881c083e1490335fff373bdeb8081ecc72cb"
BASE_COMMIT="6706e619d310e2c74fe2734cfcef8dd2f83d70d1"
CACHE_KEY="poc-e883881c083e-20260910-r5"
[[ "$ACTION" == install || "$ACTION" == remove || "$ACTION" == --remove ]] || { echo "Usage: $0 [P2K_ROOT] [install|remove]" >&2; exit 2; }
command -v python3 >/dev/null || { echo "ERROR: python3 is required." >&2; exit 3; }
export P2K_TROPHY_ROOT="$ROOT" P2K_TROPHY_ACTION="$ACTION" P2K_TROPHY_SOURCE_COMMIT="$SOURCE_COMMIT" P2K_TROPHY_BASE_COMMIT="$BASE_COMMIT" P2K_TROPHY_CACHE_KEY="$CACHE_KEY" P2K_TROPHY_INSTALLER="$0"
python3 - <<'PY'
from __future__ import annotations
import base64,datetime as dt,hashlib,io,json,os,re,shutil,sys,tarfile
from pathlib import Path

root=Path(os.environ['P2K_TROPHY_ROOT']).resolve();action=os.environ['P2K_TROPHY_ACTION'];source=os.environ['P2K_TROPHY_SOURCE_COMMIT'];base=os.environ['P2K_TROPHY_BASE_COMMIT'];key=os.environ['P2K_TROPHY_CACHE_KEY'];installer=Path(os.environ['P2K_TROPHY_INSTALLER']).resolve()
state_dir=root/'.p2k-poc-state';state_path=state_dir/'trophy-gallery-overlay.json';backups=root/'.p2k-poc-backups';begin='/* P2K_TROPHY_GALLERY_POC_OVERLAY_BEGIN */';end='/* P2K_TROPHY_GALLERY_POC_OVERLAY_END */';sentinel='return Object.freeze({ tools, renderTools, routeFallback });'
payload=['assets/js/admin/admin-shell.js','assets/js/admin/trophy-gallery-poc.js','assets/js/pages/dashboard-v2.js','assets/trophy-gallery/engraving/P2KFullSans.ttf','assets/trophy-gallery/engraving/editor.html',*[f'assets/trophy-gallery/engraving/{kind}_{finish}.png' for kind in ('medal','cup','crystal') for finish in ('gold','silver','bronze')],'server/trophy-gallery/src/TrophyGalleryStore.php','server/trophy-gallery/public/api.php','server/trophy-gallery/public/media.php','server/trophy-gallery/resources/catalog.seed.json','trophies/index.html','tools/poc/engraving/README.md']
integration=['assets/js/admin/tool-registry.js','ui-v2.html'];managed=payload+integration;registry=root/integration[0];ui=root/integration[1]
def die(msg,code=10):print('ERROR:',msg,file=sys.stderr);raise SystemExit(code)
def atomic(path,data):path.parent.mkdir(parents=True,exist_ok=True);tmp=path.with_name(path.name+'.trophy-r5.tmp');tmp.write_bytes(data);os.replace(tmp,path)
def strip_block(text):return re.sub(re.escape(begin)+r'.*?'+re.escape(end)+r'\n?','',text,flags=re.S)
def strip_token(src):return re.sub(r'([?&])p2k_trophy_poc=[^&#]*',lambda m:'?' if m.group(1)=='?' else '',src).replace('?&','?').replace('&&','&').rstrip('?&')
def registry_ref(text):
 m=re.search(r'assets/js/admin/tool-registry\.js(?:\?[^"\'<> ]*)?',text)
 if not m:die('ui-v2.html has no local tool-registry reference.')
 return m
def with_token(src):src=strip_token(src);return src+('&' if '?' in src else '?')+'p2k_trophy_poc='+key
def restore(backup,meta):
 for rel,info in meta['files'].items():
  target=root/rel;saved=backup/'files'/rel
  if info['existed']:target.parent.mkdir(parents=True,exist_ok=True);shutil.copy2(saved,target)
  elif target.is_file():target.unlink()
def embedded():
 raw=installer.read_bytes();marker=b'\n__P2K_TROPHY_R5_PAYLOAD_BELOW__\n';pos=raw.find(marker)
 if pos<0:die('Embedded payload marker is missing.')
 try:return base64.b64decode(raw[pos+len(marker):].strip(),validate=True)
 except Exception as exc:die('Embedded payload is invalid: '+str(exc))

if not root.is_dir() or not registry.is_file() or not ui.is_file():die('Target is not a recognizable Promote to King tree.')
if not re.search(r'\b2\.11\.\d+',ui.read_text(encoding='utf-8',errors='replace')):die('Installer supports Promote to King 2.11.x only.')
existing=json.loads(state_path.read_text()) if state_path.is_file() else None
if action in ('remove','--remove'):
 if not isinstance(existing,dict) or existing.get('overlay_version')!=5:die('Trophy Gallery r5 installation state was not found.')
 restore(Path(existing['original_backup']),existing);state_path.unlink();print('Trophy Gallery r5 removed; data/trophy-gallery was retained.');print('Restored:',existing['original_backup']);raise SystemExit(0)

archive=embedded()
with tarfile.open(fileobj=io.BytesIO(archive),mode='r:gz') as tar:
 manifest=json.load(tar.extractfile('manifest.json'))
 if manifest.get('source_commit')!=source or manifest.get('base_commit')!=base:die('Embedded payload identity mismatch.')
 for rel,expected in manifest['payload_sha256'].items():
  data=tar.extractfile('payload/'+rel).read()
  if hashlib.sha256(data).hexdigest()!=expected:die('Embedded payload hash mismatch: '+rel)
stamp=dt.datetime.now(dt.timezone.utc).strftime('%Y%m%dT%H%M%S%fZ');rollback=backups/f'trophy-gallery-r5-run-{stamp}';(rollback/'files').mkdir(parents=True)
reinstall=isinstance(existing,dict) and existing.get('overlay_version')==5
original=Path(existing['original_backup']) if reinstall else backups/f'trophy-gallery-r5-original-{stamp}';files=existing['files'] if reinstall else {}
if not reinstall:(original/'files').mkdir(parents=True)
r4=isinstance(existing,dict) and existing.get('overlay_version')==4
for rel in managed:
 target=root/rel
 if not reinstall:
  existed=target.is_file();files[rel]={'existed':existed,'sha256':hashlib.sha256(target.read_bytes()).hexdigest() if existed else None}
  if existed:
   saved=original/'files'/rel;saved.parent.mkdir(parents=True,exist_ok=True);shutil.copy2(target,saved)
 if target.is_file():saved=rollback/'files'/rel;saved.parent.mkdir(parents=True,exist_ok=True);shutil.copy2(target,saved)
if r4:
 with tarfile.open(fileobj=io.BytesIO(archive),mode='r:gz') as tar:
  for rel in integration+['assets/js/admin/admin-shell.js','assets/js/pages/dashboard-v2.js']:
   saved=original/'files'/rel;saved.parent.mkdir(parents=True,exist_ok=True);saved.write_bytes(tar.extractfile('base/'+rel).read());files[rel]={'existed':True,'sha256':hashlib.sha256(saved.read_bytes()).hexdigest()}
  for rel in payload:
   if rel not in ('assets/js/admin/admin-shell.js','assets/js/pages/dashboard-v2.js'):files[rel]={'existed':False,'sha256':None}
catalog=root/'data/trophy-gallery/catalog.json';catalog_existed=catalog.is_file();catalog_before=catalog.read_bytes() if catalog_existed else None
current={rel:{'existed':(root/rel).is_file()} for rel in managed}
try:
 with tarfile.open(fileobj=io.BytesIO(archive),mode='r:gz') as tar:
  for rel in payload:atomic(root/rel,tar.extractfile('payload/'+rel).read())
 registry_text=strip_block(registry.read_text(encoding='utf-8'))
 if sentinel not in registry_text:die('Unsupported tool-registry layout; rollback required.')
 block=f'''{begin}\nfunction loadTrophyGalleryPocOverlay() {{\nif (window.P2K_TROPHY_GALLERY_POC) {{ window.P2K_TROPHY_GALLERY_POC.mount?.(context); return; }}\nif (document.getElementById("p2kTrophyGalleryPocScript")) return;\nconst script=document.createElement("script");script.id="p2kTrophyGalleryPocScript";script.src="assets/js/admin/trophy-gallery-poc.js?v={key}";script.defer=true;script.onload=()=>window.P2K_TROPHY_GALLERY_POC?.mount?.(context);document.head.appendChild(script);\n}}\nloadTrophyGalleryPocOverlay();\n{end}\n'''
 atomic(registry,(registry_text.replace(sentinel,block+sentinel,1)).encode())
 ui_text=ui.read_text(encoding='utf-8');match=registry_ref(ui_text);atomic(ui,(ui_text[:match.start()]+with_token(match.group(0))+ui_text[match.end():]).encode())
 if not catalog.exists():atomic(catalog,(root/'server/trophy-gallery/resources/catalog.seed.json').read_bytes());catalog.chmod(0o640)
 if os.environ.get('P2K_TROPHY_TEST_FAIL_AFTER_INSTALL')=='1':die('Intentional qualification failure after file installation.')
 state_dir.mkdir(parents=True,exist_ok=True);meta={'overlay_version':5,'source_commit':source,'base_commit':base,'cache_key':key,'installed_utc':stamp,'original_backup':str(original),'files':files};atomic(state_path,(json.dumps(meta,indent=2)+'\n').encode())
 if key not in registry.read_text() or key not in ui.read_text() or not (root/'trophies/index.html').is_file():die('Installed tree failed r5 validation.')
 print('Trophy Gallery r5 installed successfully.');print('Runtime source:',source);print('Cache key:',key);print('Rollback backup:',rollback);print('Persistent catalogue/media:',root/'data/trophy-gallery');print('Configuration, databases, OAuth, CRON and the qualified P2K v= key were preserved.')
except BaseException:
 try:
  restore(rollback,{'files':current})
  if catalog_existed:atomic(catalog,catalog_before)
  elif catalog.is_file():catalog.unlink()
  if existing is not None:atomic(state_path,(json.dumps(existing,indent=2)+'\n').encode())
  elif state_path.is_file():state_path.unlink()
  print('Rollback completed from:',rollback,file=sys.stderr)
 except Exception as exc:print('WARNING: rollback failed:',exc,file=sys.stderr)
 raise
PY
exit 0
__P2K_TROPHY_R5_PAYLOAD_BELOW__

