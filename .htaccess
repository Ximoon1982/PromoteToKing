Options -Indexes
DirectoryIndex index.html index.php

# BEGIN P2K OAUTH CALLBACK
<IfModule mod_alias.c>
  # Chess.com is registered to this exact extensionless redirect URI.
  # RedirectMatch preserves the authorization code/state query string.
  RedirectMatch 302 ^/auth/callback$ /auth/callback.php
</IfModule>
# END P2K OAUTH CALLBACK

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # v2.14.3 Super Admin candidate preview. The cookie is only a routing hint:
  # PreviewRouter.php re-validates its HMAC, authenticated identity, registered
  # candidate, and preview tree on every request. Recovery/shared paths and OAuth
  # callback remain on the stable direct-root control plane.
  #
  # One narrow exception: while preview is active, the read-only OAuth session
  # status probe is served by the candidate OAuthSession implementation. This lets
  # candidate reloads use the candidate's race-safe token refresh behavior without
  # moving OAuth login, callback, logout, batch traffic, or public users off 2.14.2.
  RewriteCond %{HTTP:Cookie} "(^|;[[:space:]]*)P2KRC_PREVIEW=" [NC]
  RewriteCond %{REQUEST_URI} ^/server/team-points/public/oauth\.php$ [NC]
  RewriteCond %{QUERY_STRING} (^|&)action=session(&|$) [NC]
  RewriteRule ^server/team-points/public/oauth\.php$ /server/release-control/public/preview-oauth-session.php [L]

  RewriteCond %{HTTP:Cookie} "(^|;[[:space:]]*)P2KRC_PREVIEW=" [NC]
  RewriteCond %{REQUEST_URI} !^/(?:ReleaseControl\.php|PreviewRouter\.php|server/release-control(?:/|$)|auth/callback(?:\.php)?$|data(?:/|$)|logs(?:/|$)|storage(?:/|$)) [NC]
  # Only paths selected by the P2K release-slot surface may enter preview.
  # Sibling projects hosted below the same web root must remain public.
  RewriteCond %{REQUEST_URI} ^/(?:$|(?:api|artwork|artwork-masters|assets|auth|config|resources|server|trophies)(?:/|$)|(?:VERSION|site-manifest\.json|AnalyzeMatch\.html|AnalyzeMatchModal\.html|AnalyzeMatches\.htm|ChallengeListAssistant\.html|ClubIntelligence\.html|DataReconciliation\.html|FindMatch\.htm|InsightsHealth\.html|LeagueSeasonCenter\.html|LiveRanks\.html|LiveRanksDemo\.html|MatchCreationAnalyzer\.htm|MaxRatingBackfill\.php|MigrationInstaller\.html|Opponents\.html|OpponentsDemo\.html|RecruitMatch\.html|RecruitmentAdmin\.html|RecruitmentDemandPlanner\.html|TaskControl\.html|TaskLogs\.html|TeamInsights\.html|TeamPointsAdmin\.html|TeamPointsMigration\.html|TournamentAchievementBadgesDemo\.html|TournamentManagement\.html|Tournaments\.html|UIv2RepresentativeDemo\.html|OAuthTest\.php|index\.html|ui-v2\.html)$) [NC]
  RewriteRule ^(?!PreviewRouter\.php$)(.*)$ /PreviewRouter.php [L]

  # Backward-compatible internal routing for old slashless API URLs.
  RewriteRule ^api/(challenge-club-list|match-assistant-log|match-assistant-logs|track-upcoming-league-matches|match-history|tracked-match-data|scheduled-task-logs)$ api/index.php [END,QSA]
  # Never serve the JSON storage or raw JSONL logs directly.
  RewriteRule ^(?:data|logs)(?:/|$) - [R=404,END]
</IfModule>

# Keep HTML release shells fresh while allowing versioned static assets to be cached safely.
<IfModule mod_headers.c>
  <FilesMatch "\.(?:html?|json)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
  <FilesMatch "\.(?:js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(?:png|jpe?g|webp|gif|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000, stale-while-revalidate=604800"
  </FilesMatch>
</IfModule>
