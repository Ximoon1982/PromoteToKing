--- a/.github/workflows/trophy-gallery-poc.yml
+++ b/.github/workflows/trophy-gallery-poc.yml
@@ -22,7 +22,10 @@
         with:
           python-version: '3.12'
       - name: Install regression dependencies
-        run: python -m pip install --disable-pip-version-check -r tests/requirements.txt
+        run: |
+          python -m pip install --disable-pip-version-check -r tests/requirements.txt
+          python -m playwright install --with-deps chromium
+          sudo ln -sf "$(find "$HOME/.cache/ms-playwright" -type f -name chrome -path '*chrome-linux*' | head -1)" /usr/bin/chromium
       - name: JavaScript syntax
         run: |
           node --check assets/js/admin/tool-registry.js
