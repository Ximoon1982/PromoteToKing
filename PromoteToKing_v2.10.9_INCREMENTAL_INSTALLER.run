#!/usr/bin/env bash
# Promote to King v2.10.9 incremental installer.
# Durable MCA full-arena acquisition from canonical v2.10.8.
set -Eeuo pipefail

TARGET_VERSION="2.10.9"
PREDECESSOR_VERSION="2.10.8"
TARGET="${1:-${P2K_SITE_ROOT:-$PWD}}"
MARKER="__P2K_V2109_PAYLOAD_BELOW__"
SELF="$0"
MANIFEST=".p2k-v2109-payload-manifest.json"

fail(){ echo "ERROR: $*" >&2; exit 2; }
command -v python3 >/dev/null 2>&1 || fail "python3 is required."
command -v tar >/dev/null 2>&1 || fail "tar is required."

choose_php(){
  local candidate resolved
  for candidate in "${P2K_PHP_CLI:-}" \
    /usr/bin/php8.5-cli /usr/bin/php8.5 \
    /usr/bin/php8.4-cli /usr/bin/php8.4 \
    /usr/bin/php8.3-cli /usr/bin/php8.3 \
    /usr/bin/php8.2-cli /usr/bin/php8.2 \
    /usr/bin/php8.1-cli /usr/bin/php8.1 \
    php8.5-cli php8.5 php8.4-cli php8.4 php8.3-cli php8.3 php8.2-cli php8.2 php8.1-cli php8.1 php; do
    [[ -n "$candidate" ]] || continue
    resolved="$candidate"
    [[ "$candidate" == */* ]] || resolved="$(command -v "$candidate" 2>/dev/null || true)"
    [[ -n "$resolved" && -x "$resolved" ]] || continue
    if "$resolved" -r 'exit(PHP_SAPI === "cli" && PHP_VERSION_ID >= 80100 ? 0 : 1);' >/dev/null 2>&1; then
      printf '%s\n' "$resolved"; return 0
    fi
  done
  return 1
}

PHP_BIN="$(choose_php || true)"
[[ -n "$PHP_BIN" ]] || fail "Compatible PHP CLI not found (PHP 8.1+ required). On IONOS prefer /usr/bin/php8.5-cli."
PHP_VERSION="$($PHP_BIN -r 'echo PHP_VERSION;' 2>/dev/null || true)"
echo "Using PHP CLI: $PHP_BIN (${PHP_VERSION:-unknown version})"

[[ -d "$TARGET" ]] || fail "Target directory does not exist: $TARGET"
TARGET="$(cd "$TARGET" && pwd -P)"
[[ -f "$TARGET/VERSION" ]] || fail "VERSION file is missing from target."
CURRENT="$(tr -d '\r\n' < "$TARGET/VERSION")"
case "$CURRENT" in
  "$PREDECESSOR_VERSION"|"$TARGET_VERSION") ;;
  *) fail "Unsupported target VERSION '$CURRENT'. Expected $PREDECESSOR_VERSION (or $TARGET_VERSION for idempotent replay)." ;;
esac
for f in server/team-points/src/Repository.php server/team-points/src/McaResultsCronService.php server/team-points/bin/mca-results-sync.php site-manifest.json; do
  [[ -f "$TARGET/$f" ]] || fail "Required application file missing: $f"
done

STAGE="$(mktemp -d "${TMPDIR:-/tmp}/p2k-v2109.XXXXXX")"
STAMP="$(date -u +%Y%m%d-%H%M%S)"
BACKUP="$TARGET/.p2k-backups/v2.10.9-$STAMP-$$"
NEW_LIST="$BACKUP/new-files.txt"
CRON_BACKUP="$BACKUP/crontab.before"
ROLLBACK_ARMED=0
HAS_CRONTAB=0
command -v crontab >/dev/null 2>&1 && HAS_CRONTAB=1
cleanup(){ rm -rf "$STAGE"; }
restore_files(){
  python3 - "$TARGET" "$BACKUP" "$NEW_LIST" <<'PYRESTORE'
from pathlib import Path
import shutil,sys
root=Path(sys.argv[1]); backup=Path(sys.argv[2]); new_list=Path(sys.argv[3])
if new_list.exists():
    for rel in reversed(new_list.read_text(encoding='utf-8').splitlines()):
        if not rel: continue
        p=root/rel
        try:
            if p.is_symlink() or p.is_file(): p.unlink()
            elif p.is_dir(): shutil.rmtree(p)
        except FileNotFoundError: pass
saved=backup/'files'
if saved.exists():
    for p in sorted(saved.rglob('*')):
        if not p.is_file() and not p.is_symlink(): continue
        rel=p.relative_to(saved); dst=root/rel; dst.parent.mkdir(parents=True,exist_ok=True)
        if p.is_symlink():
            try: dst.unlink()
            except FileNotFoundError: pass
            dst.symlink_to(p.readlink())
        else: shutil.copy2(p,dst)
PYRESTORE
}
restore_cron(){
  [[ "$HAS_CRONTAB" == 1 ]] || return 0
  if [[ -s "$CRON_BACKUP" ]]; then crontab "$CRON_BACKUP" || true
  else crontab -r 2>/dev/null || true
  fi
}
on_error(){
  rc=$?
  if [[ "$ROLLBACK_ARMED" == 1 ]]; then
    echo "Installation failed; restoring application files and previous crontab from $BACKUP ..." >&2
    restore_files || true
    restore_cron || true
  fi
  cleanup
  exit "$rc"
}
trap on_error ERR INT TERM
trap cleanup EXIT

PAYLOAD_LINE="$(awk -v m="$MARKER" '$0==m {print NR+1; exit}' "$SELF")"
[[ -n "$PAYLOAD_LINE" ]] || fail "Embedded payload marker not found."

echo "[1/7] Extracting and verifying v$TARGET_VERSION payload..."
tail -n +"$PAYLOAD_LINE" "$SELF" | tar -xzf - -C "$STAGE"
[[ -f "$STAGE/$MANIFEST" ]] || fail "Payload manifest missing."
python3 - "$STAGE" "$STAGE/$MANIFEST" <<'PYVERIFY'
from pathlib import Path
import hashlib,json,sys
root=Path(sys.argv[1]); m=json.loads(Path(sys.argv[2]).read_text(encoding='utf-8'))
if m.get('version')!='2.10.9' or m.get('predecessor')!='2.10.8': raise SystemExit('manifest version boundary mismatch')
if len(m.get('files',[])) != 41: raise SystemExit(f'unexpected payload file count: {len(m.get("files",[]))}')
for row in m.get('files',[]):
    rel=row['path']; rp=Path(rel)
    if rp.is_absolute() or '..' in rp.parts: raise SystemExit(f'unsafe payload path: {rel}')
    p=root/rp
    if not p.is_file(): raise SystemExit(f'missing payload file: {rel}')
    data=p.read_bytes()
    if len(data)!=row['size'] or hashlib.sha256(data).hexdigest()!=row['sha256']: raise SystemExit(f'payload hash mismatch: {rel}')
print(f"verified {len(m['files'])} complete payload files")
PYVERIFY

echo "[2/7] Linting staged PHP, JS-adjacent shell and release metadata..."
for f in server/team-points/src/McaArenaParser.php server/team-points/src/McaResultsCronService.php server/team-points/src/Repository.php server/team-points/bin/mca-results-sync.php server/team-points/bin/upgrade-schema-v2.10.9.php; do
  "$PHP_BIN" -d display_errors=1 -l "$STAGE/$f"
done
bash -n "$STAGE/cron-mca-arena-v2.10.9.sh"
bash -n "$STAGE/reset-install-mca-cron-v2.10.9.sh"
python3 -m json.tool "$STAGE/site-manifest.json" >/dev/null

echo "[3/7] Backing up touched files and current crontab..."
mkdir -p "$BACKUP/files"
: > "$NEW_LIST"
if [[ "$HAS_CRONTAB" == 1 ]]; then crontab -l > "$CRON_BACKUP" 2>/dev/null || : > "$CRON_BACKUP"; else : > "$CRON_BACKUP"; fi
python3 - "$TARGET" "$STAGE/$MANIFEST" "$BACKUP" "$NEW_LIST" <<'PYBACKUP'
from pathlib import Path
import json,shutil,sys
root=Path(sys.argv[1]); m=json.loads(Path(sys.argv[2]).read_text()); backup=Path(sys.argv[3]); new=Path(sys.argv[4])
new_rows=[]
for row in m['files']:
    rel=Path(row['path']); dst=root/rel
    if dst.exists() or dst.is_symlink():
        if not dst.is_file() and not dst.is_symlink(): raise SystemExit(f'destination is not a file: {rel}')
        b=backup/'files'/rel; b.parent.mkdir(parents=True,exist_ok=True)
        if dst.is_symlink(): b.symlink_to(dst.readlink())
        else: shutil.copy2(dst,b)
    else: new_rows.append(str(rel))
new.write_text('\n'.join(new_rows)+('\n' if new_rows else ''),encoding='utf-8')
print(f"backup: {len(m['files'])-len(new_rows)} existing, {len(new_rows)} new")
PYBACKUP
ROLLBACK_ARMED=1

echo "[4/7] Installing complete v$TARGET_VERSION files..."
python3 - "$TARGET" "$STAGE" "$STAGE/$MANIFEST" <<'PYINSTALL'
from pathlib import Path
import json,os,shutil,sys
root=Path(sys.argv[1]); stage=Path(sys.argv[2]); m=json.loads(Path(sys.argv[3]).read_text())
for row in m['files']:
    rel=Path(row['path']); src=stage/rel; dst=root/rel; dst.parent.mkdir(parents=True,exist_ok=True)
    tmp=dst.with_name(dst.name+f'.p2k-v2109-{os.getpid()}.tmp')
    shutil.copy2(src,tmp); os.replace(tmp,dst)
PYINSTALL
chmod 755 "$TARGET/cron-mca-arena-v2.10.9.sh" "$TARGET/reset-install-mca-cron-v2.10.9.sh" 2>/dev/null || true

echo "[5/7] Applying additive Analytics schema 10..."
P2K_SITE_ROOT="$TARGET" "$PHP_BIN" "$TARGET/server/team-points/bin/upgrade-schema-v2.10.9.php"

echo "[6/7] Installing the dedicated MCA every-minute scheduler while preserving unrelated CRON..."
P2K_PHP_CLI="$PHP_BIN" bash "$TARGET/reset-install-mca-cron-v2.10.9.sh" "$TARGET"

if [[ "${P2K_INSTALL_TEST_FAIL_AFTER_CRON:-0}" == 1 ]]; then
  echo "TEST: forcing failure after CRON installation." >&2
  false
fi

echo "[7/7] Verifying installed files, schema boundary and MCA scheduler..."
python3 - "$TARGET" "$STAGE/$MANIFEST" <<'PYPOST'
from pathlib import Path
import hashlib,json,sys
root=Path(sys.argv[1]); m=json.loads(Path(sys.argv[2]).read_text())
for row in m['files']:
    p=root/row['path']; data=p.read_bytes()
    if len(data)!=row['size'] or hashlib.sha256(data).hexdigest()!=row['sha256']: raise SystemExit(f'installed hash mismatch: {row["path"]}')
print(f"verified {len(m['files'])} installed files")
PYPOST
[[ "$(tr -d '\r\n' < "$TARGET/VERSION")" == "$TARGET_VERSION" ]] || fail "VERSION did not advance to $TARGET_VERSION"
[[ "$(tr -d '\r\n' < "$TARGET/MIGRATION_VERSION")" == "$TARGET_VERSION" ]] || fail "MIGRATION_VERSION did not advance to $TARGET_VERSION"
P2K_SITE_ROOT="$TARGET" "$PHP_BIN" "$TARGET/server/team-points/bin/upgrade-schema-v2.10.9.php" >/dev/null
if [[ "$HAS_CRONTAB" == 1 ]]; then
  COUNT="$(crontab -l 2>/dev/null | grep -c 'cron-mca-arena-v2.10.9.sh' || true)"
  [[ "$COUNT" == 1 ]] || fail "Expected exactly one v2.10.9 MCA scheduler entry; found $COUNT."
fi
ROLLBACK_ARMED=0

echo "Promote to King v$TARGET_VERSION installed successfully."
echo "Backup retained at: $BACKUP"
echo "Analytics schema 10 is additive; existing MCA Results sources and runtime data were preserved."
echo "MCA arena acquisition now runs every minute in <=55-second requested slices; discovery remains due-gated to 12 hours and Chess.com fetches remain serial at >=1 second spacing."
echo "Unrelated CRON entries were preserved."
exit 0

__P2K_V2109_PAYLOAD_BELOW__
