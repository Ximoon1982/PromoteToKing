#!/usr/bin/env bash
set -euo pipefail

RELEASE='2.11.0'
CORRECTIVE='R5'
SELF="${BASH_SOURCE[0]}"
TARGET="${1:-.}"
TARGET="$(cd "$TARGET" && pwd)"
MARKER='__P2K_V2110_R5_PAYLOAD_BELOW__'
EXPECTED_PAYLOAD_SHA='99832a9e014e35999b163a594186e1aafc4531d7ebb0ce7061c14318a1560b56'
TRANSACTION_ACTIVE=0
BACKUP=''
CREATED=()

rollback(){
  local status="${1:-$?}"
  trap - ERR
  if ((TRANSACTION_ACTIVE)); then
    printf 'Failure detected; restoring pre-%s %s files...\n' "$RELEASE" "$CORRECTIVE" >&2
    for file in "${CREATED[@]}"; do rm -f "$TARGET/$file" || true; done
    if [[ -n "$BACKUP" && -f "$BACKUP" ]]; then tar -C "$TARGET" -xzf "$BACKUP" || true; fi
  fi
  exit "$status"
}
fail(){
  printf 'ERROR: %s\n' "$*" >&2
  if ((TRANSACTION_ACTIVE)); then rollback 1; fi
  exit 1
}
choose_php(){
  local candidate
  for candidate in "${P2K_PHP_BIN:-}" /usr/bin/php8.5-cli /usr/bin/php8.4-cli /usr/bin/php8.3-cli /usr/bin/php8.2-cli /usr/bin/php8.1-cli /usr/bin/php8.0-cli "$(command -v php 2>/dev/null || true)"; do
    [[ -n "$candidate" && -x "$candidate" ]] && { printf '%s\n' "$candidate"; return 0; }
  done
  return 1
}

command -v tar >/dev/null 2>&1 || fail 'tar is required.'
command -v base64 >/dev/null 2>&1 || fail 'base64 is required.'
command -v sha256sum >/dev/null 2>&1 || fail 'sha256sum is required.'
PHP_BIN="$(choose_php)" || fail 'PHP CLI was not found.'
[[ -f "$TARGET/VERSION" ]] || fail "No Promote to King VERSION file found in $TARGET"
INSTALLED="$(tr -d '\r\n[:space:]' < "$TARGET/VERSION")"
[[ "$INSTALLED" == "$RELEASE" ]] || fail "R5 requires an existing v$RELEASE installation; found v$INSTALLED."
[[ -f "$TARGET/server/team-points/src/PublicReadDatabase.php" ]] || fail 'Green-primary Team Points baseline is missing PublicReadDatabase.php.'
[[ -f "$TARGET/server/team-points-green/sql/core-schema.sql" ]] || fail 'Green Core baseline is missing.'

TMP="$(mktemp -d "${TMPDIR:-/tmp}/p2k-v2110-r5.XXXXXX")"
cleanup(){ rm -rf "$TMP"; }
trap cleanup EXIT
LINE="$(awk -v marker="$MARKER" '$0==marker{print NR+1; exit}' "$SELF")"
[[ -n "$LINE" ]] || fail 'Installer payload marker is missing.'
tail -n +"$LINE" "$SELF" | base64 -d > "$TMP/payload.tar.gz"
ACTUAL="$(sha256sum "$TMP/payload.tar.gz" | awk '{print $1}')"
[[ "$ACTUAL" == "$EXPECTED_PAYLOAD_SHA" ]] || fail 'Installer payload checksum mismatch.'
mkdir -p "$TMP/payload"
tar -C "$TMP/payload" -xzf "$TMP/payload.tar.gz"
[[ "$(tr -d '\r\n[:space:]' < "$TMP/payload/VERSION")" == "$RELEASE" ]] || fail 'Payload VERSION mismatch.'

"$PHP_BIN" -l "$TMP/payload/server/team-points/public/recruitment-admin.php" >/dev/null || fail 'Recruitment PHP syntax check failed.'
"$PHP_BIN" -l "$TMP/payload/server/team-points/public/intelligence.php" >/dev/null || fail 'Intelligence PHP syntax check failed.'
"$PHP_BIN" -l "$TMP/payload/server/team-points/public/data-reconciliation.php" >/dev/null || fail 'Retired reconciliation PHP syntax check failed.'
"$PHP_BIN" -l "$TMP/payload/server/team-points/src/GreenFreshnessService.php" >/dev/null || fail 'Green freshness service PHP syntax check failed.'
if command -v node >/dev/null 2>&1; then
  for file in ui-version-gate.js v2-11-0.js v2-11-0-green-primary.js v2-11-0-r2-admin-stability.js v2-11-0-green-freshness.js; do
    node --check "$TMP/payload/assets/js/pages/$file" >/dev/null || fail "JavaScript syntax check failed: $file"
  done
  node --check "$TMP/payload/assets/js/site-config.js" >/dev/null || fail 'Site config JavaScript syntax check failed.'
fi
grep -Fq 'assets/js/site-config.js?v=2.11.0-r5' "$TMP/payload/ui-v2.html" || fail 'R5 dashboard cache key is missing.'
grep -Fq 'P2K_RECRUITMENT_MAX_CANDIDATES = 100000' "$TMP/payload/server/team-points/public/recruitment-admin.php" || fail '100,000 Recruitment capacity marker is missing.'
grep -Fq 'RECONCILIATION_RETIRED' "$TMP/payload/server/team-points/public/data-reconciliation.php" || fail 'Retired reconciliation marker is missing.'
grep -Fq "'source'=>'green_native_core'" "$TMP/payload/server/team-points/src/GreenFreshnessService.php" || fail 'Green-native Freshness marker is missing.'
! grep -Fq 'v2-11-0-r4-recruitment-integration' "$TMP/payload/assets/js/site-config.js" || fail 'Retired R4 Recruitment loader is still active.'

FILES=(
  ClubIntelligence.html
  ui-v2.html
  assets/js/site-config.js
  assets/js/pages/ui-version-gate.js
  assets/js/pages/v2-11-0.js
  assets/js/pages/v2-11-0-green-primary.js
  assets/js/pages/v2-11-0-r2-admin-stability.js
  assets/js/pages/v2-11-0-green-freshness.js
  server/team-points/public/recruitment-admin.php
  server/team-points/public/intelligence.php
  server/team-points/public/data-reconciliation.php
  server/team-points/src/GreenFreshnessService.php
  VERSION
  RELEASE_NOTES_v2.11.0_R5.md
  R5_SOURCE_HEAD.txt
)
EXISTING=()
for file in "${FILES[@]}"; do
  if [[ -e "$TARGET/$file" ]]; then EXISTING+=("$file"); else CREATED+=("$file"); fi
done
BACKUP_ROOT="$TARGET/data/release-backups"
mkdir -p "$BACKUP_ROOT"
BACKUP="$BACKUP_ROOT/v2.11.0-R5-$(date -u +%Y%m%dT%H%M%SZ)-$$.tar.gz"
if ((${#EXISTING[@]})); then tar -C "$TARGET" -czf "$BACKUP" "${EXISTING[@]}"; fi

TRANSACTION_ACTIVE=1
trap 'rollback $?' ERR
mkdir -p "$TARGET/assets/js/pages" "$TARGET/assets/js" "$TARGET/server/team-points/public" "$TARGET/server/team-points/src"
for file in "${FILES[@]}"; do
  mkdir -p "$TARGET/$(dirname "$file")"
  install -m 0644 "$TMP/payload/$file" "$TARGET/$file"
done

[[ "$(tr -d '\r\n[:space:]' < "$TARGET/VERSION")" == "$RELEASE" ]] || fail 'Installed VERSION verification failed.'
grep -Fq 'assets/js/site-config.js?v=2.11.0-r5' "$TARGET/ui-v2.html" || fail 'Installed R5 dashboard cache-key verification failed.'
grep -Fq 'assets/js/pages/v2-11-0.js?v=2.11.0-r5' "$TARGET/assets/js/site-config.js" || fail 'Installed canonical Admin loader verification failed.'
! grep -Fq 'v2-11-0-r4-recruitment-integration' "$TARGET/assets/js/site-config.js" || fail 'Installed config still activates the retired R4 bridge.'
grep -Fq 'P2K_RECRUITMENT_MAX_CANDIDATES = 100000' "$TARGET/server/team-points/public/recruitment-admin.php" || fail 'Installed Recruitment capacity verification failed.'
grep -Fq 'membership-batch' "$TARGET/assets/js/pages/v2-11-0.js" || fail 'Installed Green membership preparation verification failed.'
grep -Fq 'RECONCILIATION_RETIRED' "$TARGET/server/team-points/public/data-reconciliation.php" || fail 'Installed reconciliation retirement verification failed.'
grep -Fq 'v2-11-0-green-freshness.js?v=2.11.0-r5' "$TARGET/ClubIntelligence.html" || fail 'Installed Green Freshness UI verification failed.'
grep -Fq "'source'=>'green_native_core'" "$TARGET/server/team-points/src/GreenFreshnessService.php" || fail 'Installed Green Freshness backend verification failed.'

TRANSACTION_ACTIVE=0
trap - ERR
printf 'Promote to King v%s %s installed successfully in %s\n' "$RELEASE" "$CORRECTIVE" "$TARGET"
[[ -f "$BACKUP" ]] && printf 'Backup: %s\n' "$BACKUP"
printf 'PHP CLI: %s\n' "$PHP_BIN"
exit 0
