#!/usr/bin/env bash
set -euo pipefail
RELEASE='2.11.0'; CORRECTIVE='R6-final-embedded'; SELF="${BASH_SOURCE[0]}"; TARGET="${1:-.}"; TARGET="$(cd "$TARGET" && pwd)"
MARKER='__P2K_V2110_R6_FINAL_PAYLOAD__'; EXPECTED_PAYLOAD_SHA='c66aa454ad600139eb823b15248d70c40a1d2abf9d7026aaeab69d80b040e798'; TRANSACTION_ACTIVE=0; BACKUP=''; CREATED=()
cleanup_tmp(){ [[ -n "${TMP:-}" ]] && rm -rf "$TMP" || true; }
rollback(){ local s="${1:-1}"; trap - ERR; if ((TRANSACTION_ACTIVE)); then for f in "${CREATED[@]}"; do rm -f "$TARGET/$f" || true; done; [[ -n "$BACKUP" && -f "$BACKUP" ]] && tar -C "$TARGET" -xzf "$BACKUP" || true; fi; cleanup_tmp; exit "$s"; }
fail(){ echo "ERROR: $*" >&2; ((TRANSACTION_ACTIVE)) && rollback 1; exit 1; }
choose_php(){ local c; for c in "${P2K_PHP_BIN:-}" /usr/bin/php8.5-cli /usr/bin/php8.4-cli /usr/bin/php8.3-cli /usr/bin/php8.2-cli /usr/bin/php8.1-cli /usr/bin/php8.0-cli "$(command -v php 2>/dev/null || true)"; do [[ -n "$c" && -x "$c" ]] && { echo "$c"; return; }; done; return 1; }
for c in tar base64 sha256sum awk tail mktemp; do command -v "$c" >/dev/null || fail "$c is required."; done
PHP_BIN="$(choose_php)" || fail 'PHP CLI not found.'
[[ -f "$TARGET/VERSION" ]] || fail "No Promote to King VERSION file in $TARGET"
[[ "$(tr -d '\r\n[:space:]' < "$TARGET/VERSION")" == "$RELEASE" ]] || fail 'R6 requires an existing v2.11.0 installation.'
[[ -f "$TARGET/server/team-points/src/PublicReadDatabase.php" ]] || fail 'Green-primary baseline missing.'
[[ -f "$TARGET/server/team-points-green/sql/core-schema.sql" ]] || fail 'Green Core baseline missing.'
[[ -f "$TARGET/assets/js/shared/api-client.js" ]] || fail 'Shared Chess.com API client missing.'
grep -Fq 'const OAUTH_LOGICAL_CONCURRENCY = 256;' "$TARGET/assets/js/shared/api-client.js" || fail 'Installed API client lacks OAuth logical feeder.'
grep -Fq 'processPriority' "$TARGET/assets/js/shared/api-client.js" || fail 'Installed API client lacks priority scheduler.'

TMP="$(mktemp -d "${TMPDIR:-/tmp}/p2k-v2110-r6-final.XXXXXX")"; trap cleanup_tmp EXIT
LINE="$(awk -v m="$MARKER" '$0==m{print NR+1;exit}' "$SELF")"; [[ -n "$LINE" ]] || fail 'Payload marker missing.'
tail -n +"$LINE" "$SELF" | base64 -d > "$TMP/payload.tar.gz"
[[ "$(sha256sum "$TMP/payload.tar.gz" | awk '{print $1}')" == "$EXPECTED_PAYLOAD_SHA" ]] || fail 'Payload checksum mismatch.'
mkdir -p "$TMP/payload"; tar -C "$TMP/payload" -xzf "$TMP/payload.tar.gz"
[[ "$(tr -d '\r\n[:space:]' < "$TMP/payload/VERSION")" == "$RELEASE" ]] || fail 'Payload VERSION mismatch.'
"$PHP_BIN" -l "$TMP/payload/server/team-points/public/recruitment-admin.php" >/dev/null
"$PHP_BIN" -l "$TMP/payload/server/team-points/public/intelligence.php" >/dev/null
"$PHP_BIN" -l "$TMP/payload/server/team-points/public/data-reconciliation.php" >/dev/null
"$PHP_BIN" -l "$TMP/payload/server/team-points/src/GreenFreshnessService.php" >/dev/null
grep -Fq 'RecruitmentAdmin.html?view=admin&adminCategory=members&adminDetail=recruitment' "$TMP/payload/assets/js/pages/dashboard-v2.js" || fail 'Embedded Recruitment definition missing.'
! grep -Fq 'nativeKey:"recruitment"' "$TMP/payload/assets/js/pages/dashboard-v2.js" || fail 'Native Recruitment definition remains.'
grep -Fq 'assets/js/shared/admin-page-guard.js' "$TMP/payload/RecruitmentAdmin.html" || fail 'Recruitment admin guard missing.'
grep -Fq 'assets/js/shared/embedded-page.js' "$TMP/payload/RecruitmentAdmin.html" || fail 'Recruitment embedded bridge missing.'
grep -Fq 'OAuth Bearer full throttle' "$TMP/payload/assets/js/pages/v2-11-0.js" || fail 'OAuth full-throttle Recruitment missing.'
grep -Fq 'Candidates / second' "$TMP/payload/assets/js/pages/v2-11-0.js" || fail 'Recruitment throughput telemetry missing.'
grep -Fq 'P2K_RECRUITMENT_MAX_CANDIDATES = 100000' "$TMP/payload/server/team-points/public/recruitment-admin.php" || fail '100000 candidate cap missing.'

mapfile -t FILES < <(cd "$TMP/payload" && find . -type f ! -name R6_SOURCE_HEAD.txt -printf '%P\n' | sort)
EXISTING=(); for f in "${FILES[@]}"; do [[ -f "$TARGET/$f" ]] && EXISTING+=("$f") || CREATED+=("$f"); done
mkdir -p "$TARGET/.p2k-backups"; BACKUP="$TARGET/.p2k-backups/v2.11.0-R6-final-$(date -u +%Y%m%dT%H%M%SZ)-$$.tar.gz"
if ((${#EXISTING[@]})); then tar -C "$TARGET" -czf "$BACKUP" "${EXISTING[@]}"; else tar -czf "$BACKUP" --files-from /dev/null; fi
TRANSACTION_ACTIVE=1; trap 'rollback $?' ERR
(cd "$TMP/payload" && tar -cf - "${FILES[@]}") | tar -C "$TARGET" -xf -
if [[ "${P2K_R6_TEST_FAIL_AFTER_INSTALL:-0}" == '1' ]]; then false; fi
[[ "$(tr -d '\r\n[:space:]' < "$TARGET/VERSION")" == "$RELEASE" ]]
grep -Fq 'RecruitmentAdmin.html?view=admin&adminCategory=members&adminDetail=recruitment' "$TARGET/assets/js/pages/dashboard-v2.js"
grep -Fq 'assets/js/shared/embedded-page.js' "$TARGET/RecruitmentAdmin.html"
grep -Fq 'OAuth Bearer full throttle' "$TARGET/assets/js/pages/v2-11-0.js"
"$PHP_BIN" -l "$TARGET/server/team-points/public/recruitment-admin.php" >/dev/null
TRANSACTION_ACTIVE=0; trap - ERR
echo "Promote to King v2.11.0 R6 final embedded Recruitment installed successfully."
echo "Backup: $BACKUP"
exit 0
