P2K_R4_JS_B64

EXPECTED_R4_SHA="078de425cb75d0b2863ab24bcb3eca9acb917f69d31e47a2fdc528909b521d90"
ACTUAL_R4_SHA="$(sha256sum "$TMP/r4.js" | awk '{print $1}')"
[[ "$ACTUAL_R4_SHA" == "$EXPECTED_R4_SHA" ]] || fail "Embedded R4 JavaScript hash mismatch."
if command -v node >/dev/null 2>&1; then node --check "$TMP/r4.js" >/dev/null || fail "R4 JavaScript syntax check failed."; fi

mkdir -p "$(dirname "$ROOT/$R4_REL")"
cp "$TMP/r4.js" "$ROOT/$R4_REL"

cat > "$TMP/patch.php" <<'PHP_PATCH'
<?php
declare(strict_types=1);
$root = rtrim((string)($argv[1] ?? ''), '/\\');
if ($root === '') { fwrite(STDERR, "Missing root\n"); exit(2); }

$phpPath = $root . '/server/team-points/public/recruitment-admin.php';
$sitePath = $root . '/assets/js/site-config.js';
$uiPath = $root . '/ui-v2.html';

$php = file_get_contents($phpPath);
$site = file_get_contents($sitePath);
$ui = file_get_contents($uiPath);
if (!is_string($php) || !is_string($site) || !is_string($ui)) { fwrite(STDERR, "Unable to read R4 target files\n"); exit(3); }

$oldRuntime = <<<'OLD'
    $base = rtrim((string)($config['storage']['runtime_dir'] ?? dirname(__DIR__, 3) . '/data/runtime-v280'), '/\\');
OLD;
$newRuntime = <<<'NEW'
    $configured = trim((string)($config['storage']['runtime_dir'] ?? ''));
    $base = $configured !== ''
        ? rtrim($configured, '/\\')
        : dirname(__DIR__, 3) . '/data/runtime-v280';
NEW;
if (!str_contains($php, '$configured = trim((string)($config[\'storage\'][\'runtime_dir\'] ?? \'\'));')) {
    if (!str_contains($php, $oldRuntime)) { fwrite(STDERR, "Recruitment runtime anchor not found\n"); exit(4); }
    $php = str_replace($oldRuntime, $newRuntime, $php, $count);
    if ($count !== 1) { fwrite(STDERR, "Unexpected Recruitment runtime replacement count\n"); exit(5); }
}

$r3Marker = "// v2.11.0 R3: bridge the canonical Recruitment URL into the native Recruitment";
if (($start = strpos($site, $r3Marker)) !== false) {
    $blockStart = $start;
    while ($blockStart > 0 && $site[$blockStart - 1] === "\n") { $blockStart--; }
    $end = strpos($site, "\n})();", $start);
    if ($end === false) { fwrite(STDERR, "R3 loader end marker not found\n"); exit(6); }
    $end += strlen("\n})();");
    if (isset($site[$end]) && $site[$end] === "\n") $end++;
    $site = substr($site, 0, $blockStart) . substr($site, $end);
}

$r4Marker = "data-p2k-v2110-r4-recruitment-integration";
if (!str_contains($site, $r4Marker)) {
    $r4 = <<<'R4'

// v2.11.0 R4: Recruitment renders inside the canonical Admin detail shell and
// non-GET Recruitment requests reuse the secured Team Points CSRF/session client.
(() => {
  if (document.querySelector('script[data-p2k-v2110-r4-recruitment-integration]')) return;
  const script=document.createElement('script');script.src='assets/js/pages/v2-11-0-r4-recruitment-integration.js?v=2.11.0-r4';script.async=false;script.dataset.p2kV2110R4RecruitmentIntegration='1';const mount=()=>document.head.appendChild(script);if(document.head)mount();else document.addEventListener('DOMContentLoaded',mount,{once:true});
})();
R4;
    $site = rtrim($site) . "\n" . $r4;
}

$count = 0;
$ui = preg_replace('~assets/js/site-config\.js\?v=[^"\'<>[:space:]]+~', 'assets/js/site-config.js?v=2.11.0-r4', $ui, -1, $count);
if (!is_string($ui) || $count < 1) { fwrite(STDERR, "ui-v2 site-config cache-key anchor not found\n"); exit(7); }

if (file_put_contents($phpPath, $php) === false) { fwrite(STDERR, "Unable to write Recruitment endpoint\n"); exit(8); }
if (file_put_contents($sitePath, $site) === false) { fwrite(STDERR, "Unable to write site-config\n"); exit(9); }
if (file_put_contents($uiPath, $ui) === false) { fwrite(STDERR, "Unable to write ui-v2\n"); exit(10); }
PHP_PATCH

"$PHP_BIN" "$TMP/patch.php" "$ROOT" || fail "R4 source transformation failed."

if [[ "${P2K_R4_TEST_FAIL_AFTER_PATCH:-0}" == "1" ]]; then fail "Injected R4 rollback test failure."; fi

"$PHP_BIN" -l "$ROOT/$PHP_REL" >/dev/null || fail "Recruitment PHP syntax check failed after patch."
if command -v node >/dev/null 2>&1; then
  node --check "$ROOT/$R4_REL" >/dev/null || fail "Installed R4 JavaScript syntax check failed."
  node --check "$ROOT/$SITE_REL" >/dev/null || fail "site-config JavaScript syntax check failed after patch."
fi

grep -q 'data-p2k-v2110-r4-recruitment-integration' "$ROOT/$SITE_REL" || fail "R4 loader is missing after installation."
if grep -q 'data-p2k-v2110-r3-recruitment-route' "$ROOT/$SITE_REL"; then fail "Obsolete R3 Recruitment loader is still active."; fi
grep -q 'site-config.js?v=2.11.0-r4' "$ROOT/$UI_REL" || fail "ui-v2 did not receive the R4 cache key."
grep -q '\$configured = trim((string)(\$config' "$ROOT/$PHP_REL" || fail "Recruitment runtime fallback correction is missing."

RUNTIME="$ROOT/data/runtime-v280/recruitment-admin"
mkdir -p "$RUNTIME" || fail "Unable to create protected Recruitment runtime directory."
chmod 0775 "$ROOT/data/runtime-v280" "$RUNTIME" 2>/dev/null || true
TEST_FILE="$RUNTIME/.r4-write-test-$$"
printf 'ok\n' > "$TEST_FILE" || fail "Protected Recruitment runtime directory is not writable."
rm -f "$TEST_FILE"

COMMITTED=1
trap - ERR INT TERM
rm -rf "$TMP"
log "R4 installed successfully. Recruitment remains on VERSION 2.11.0."
log "Admin → Members → Recruitment now uses the canonical Admin detail shell and secured Team Points POST authentication."
