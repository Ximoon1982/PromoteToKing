#!/usr/bin/env bash
set -Eeuo pipefail

RELEASE="2.11.0-R4"
DEFAULT_ROOT="/homepages/43/d141198007/htdocs/PromoteToKing"
ROOT="${1:-${P2K_ROOT:-$DEFAULT_ROOT}}"
ROOT="${ROOT%/}"
STAMP="$(date -u +%Y%m%dT%H%M%SZ)-$$"
BACKUP="$ROOT/data/release-backups/v2.11.0-R4-$STAMP"
TMP="${TMPDIR:-/tmp}/p2k-v2110-r4-$STAMP"
R4_REL="assets/js/pages/v2-11-0-r4-recruitment-integration.js"
SITE_REL="assets/js/site-config.js"
PHP_REL="server/team-points/public/recruitment-admin.php"
UI_REL="ui-v2.html"
TOUCHED=("$R4_REL" "$SITE_REL" "$PHP_REL" "$UI_REL")
COMMITTED=0

log(){ printf '[P2K %s] %s\n' "$RELEASE" "$*"; }

find_php(){
  local candidates=(/usr/bin/php8.5-cli /usr/bin/php8.4-cli /usr/bin/php8.3-cli /usr/bin/php8.2-cli /usr/bin/php8.1-cli /usr/bin/php8.0-cli php)
  local c
  for c in "${candidates[@]}"; do
    if [[ "$c" == */* ]]; then [[ -x "$c" ]] && { printf '%s\n' "$c"; return 0; }
    elif command -v "$c" >/dev/null 2>&1; then command -v "$c"; return 0
    fi
  done
  return 1
}

rollback(){
  [[ "$COMMITTED" == "1" ]] && return 0
  log "Rolling back R4 file changes..."
  local rel src
  for rel in "${TOUCHED[@]}"; do
    src="$BACKUP/$rel"
    if [[ -f "$src" ]]; then
      mkdir -p "$(dirname "$ROOT/$rel")"
      cp -p "$src" "$ROOT/$rel"
    elif [[ -f "$BACKUP/.missing/$rel" ]]; then
      rm -f "$ROOT/$rel"
    fi
  done
}

fail(){
  printf '[P2K %s] ERROR: %s\n' "$RELEASE" "$*" >&2
  rollback || true
  exit 1
}

trap 'rc=$?; if [[ $rc -ne 0 && "$COMMITTED" != "1" ]]; then rollback || true; fi; rm -rf "$TMP" 2>/dev/null || true; exit $rc' ERR INT TERM

[[ -d "$ROOT" ]] || fail "Installation root does not exist: $ROOT"
[[ -f "$ROOT/VERSION" ]] || fail "VERSION is missing from $ROOT"
CURRENT="$(tr -d '\r\n ' < "$ROOT/VERSION")"
[[ "$CURRENT" == "2.11.0" ]] || fail "R4 requires Promote to King 2.11.0; found '$CURRENT'."
[[ -f "$ROOT/$SITE_REL" ]] || fail "$SITE_REL is missing."
[[ -f "$ROOT/$PHP_REL" ]] || fail "$PHP_REL is missing."
[[ -f "$ROOT/$UI_REL" ]] || fail "$UI_REL is missing."

PHP_BIN="$(find_php)" || fail "No supported PHP CLI was found."
log "Using PHP: $PHP_BIN"
mkdir -p "$TMP" "$BACKUP/.missing"

for rel in "${TOUCHED[@]}"; do
  if [[ -f "$ROOT/$rel" ]]; then
    mkdir -p "$BACKUP/$(dirname "$rel")"
    cp -p "$ROOT/$rel" "$BACKUP/$rel"
  else
    mkdir -p "$BACKUP/.missing/$(dirname "$rel")"
    : > "$BACKUP/.missing/$rel"
  fi
done
log "Backup: $BACKUP"

base64 -d > "$TMP/r4.js" <<'P2K_R4_JS_B64'
